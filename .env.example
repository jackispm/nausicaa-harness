# Copy to .env for local live evaluation. Never commit .env.
OPENROUTER_API_KEY=
NAUSICAA_LIVE_TESTS=0
NAUSICAA_LIVE_MODEL=openrouter:deepseek/deepseek-v4-pro-0813
NAUSICAA_EVAL_MODEL=openrouter:qwen/qwen3.7-flash
NAUSICAA_EVAL_BUDGET_USD=0.20
# Phase 2.4's frozen 30-pair/120-arm experiment. Leave disabled during normal development.
# The manifest pins its own model; this budget is an operator cap, not a target.
NAUSICAA_PHASE24_EVAL=0
# Optional path-safe artifact name. Omit for a timestamped name.
# NAUSICAA_EVAL_ID=phase-2.4-local-001
NAUSICAA_CACHE_EVAL_MODEL=openrouter:qwen/qwen3.7-flash
NAUSICAA_CACHE_EVAL_BUDGET_USD=0.05
NAUSICAA_VISION_MODEL=openrouter:amazon/nova-lite-v1
NAUSICAA_VISION_BUDGET_USD=0.05
